rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to validate My Circle updates
    function validateMyCircleUpdate(oldData, newData) {
      return !('myCircle' in oldData) || (oldData.myCircle.code == newData.myCircle.code);
    }

    // Credits and subscription start at the free defaults and are changed only by the
    // server (Admin SDK); users cannot grant themselves credits or a paid tier.
    function isFreeStartingCredits(data) {
      return !('credits' in data) ||
             (data.credits.get(['paidCredits', 'balance'], 0) == 0 &&
              data.credits.get(['paidCredits', 'totalPurchased'], 0) == 0 &&
              data.credits.get(['freeCredits', 'remaining'], 0) <= 5 &&
              data.credits.get(['freeCredits', 'total'], 0) <= 5 &&
              data.credits.get('totalAvailable', 0) <= 5);
    }

    function isFreeSubscription(data) {
      return !('subscription' in data) || data.subscription.get('tier', 'free') == 'free';
    }

    function protectedUserFieldsUnchanged() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['subscription']) &&
             (!changed.hasAny(['credits']) ||
              // one-time initialisation for older accounts that have no credits yet
              (!('credits' in resource.data) && isFreeStartingCredits(request.resource.data)));
    }

    // Users can read/write only their own profile
    match /users/{userId} {
      // Users can read and update their own document
      allow read: if request.auth != null && request.auth.uid == userId;

      // Users can write to their own document BUT with restrictions
      allow update: if request.auth != null &&
                       request.auth.uid == userId &&
                       (
                         // Allow metrics-only updates (for tracking)
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['metrics'])) ||
                         // Allow login tracking updates
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin'])) ||
                         // Allow onboarding completion updates
                         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['onboardingComplete', 'onboardingCompletedAt'])) ||
                         // OR allow general updates with earnings/code restrictions
                         ((!('myCircle' in request.resource.data) || !('earnings' in request.resource.data.myCircle)) &&
                          validateMyCircleUpdate(resource.data, request.resource.data))
                       ) &&
                       protectedUserFieldsUnchanged();

      // Allow create for initial user document, starting on the free plan
      allow create: if request.auth != null && request.auth.uid == userId &&
                       isFreeStartingCredits(request.resource.data) &&
                       isFreeSubscription(request.resource.data);

      // No list queries: profiles hold emails and health data. Finding a share recipient
      // happens in the shareRecipe Cloud Function.
    }

    // Recipe access rules
    match /recipes/{recipeId} {
      // Users can create only their own recipes. Sharing into someone else's book is done by
      // the shareRecipe Cloud Function, which cleans the copy.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Users can read and delete only their own recipes
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Owners can update, but cannot hand the recipe to another account
      allow update: if request.auth != null &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == resource.data.userId;
    }

    // Users can create variations only if:
    // - They own the variation
    // - They own the linked recipe
    match /variations/{variationId} {
      allow create, update, delete: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        get(/databases/$(database)/documents/recipes/$(request.resource.data.recipeId)).data.userId == request.auth.uid;

      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid ||
         get(/databases/$(database)/documents/recipes/$(resource.data.recipeId)).data.userId == request.auth.uid);
    }

    // Optional: allow all authenticated users to read shared starter recipes
    match /starterRecipes/{docId} {
      allow read: if request.auth != null;
    }

    // Optional: allow all authenticated users to read ingredient options
    match /ingredients/{ingredientId} {
      allow read: if request.auth != null;
    }

    // Meal plans - users can only access their own meal plans
    match /mealPlans/{mealPlanId} {
      // Allow create only if the userId in the document matches the authenticated user
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Allow read and delete only if the user owns the meal plan
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Allow update only by the owner, and the owner cannot be changed
      allow update: if request.auth != null &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == resource.data.userId;
    }

    // Shopping lists - users can only access their own shopping lists
    match /shoppingLists/{shoppingListId} {
      // Allow create only if the userId in the document matches the authenticated user
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Allow read and delete only if the user owns the shopping list
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Allow update only by the owner, and the owner cannot be changed
      allow update: if request.auth != null &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == resource.data.userId;
    }

    // Pantry items ("what we have") - users can only access their own pantry
    match /pantryItems/{pantryItemId} {
      // Allow create only if the userId in the document matches the authenticated user
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;

      // Allow read and delete only if the user owns the item
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Allow update only by the owner, and the owner cannot be changed
      allow update: if request.auth != null &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;
    }

    // Global Diet Types - new centralized collection
    match /globalDietTypes/{dietTypeId} {
      // Anyone authenticated can read
      allow read: if request.auth != null;

      // Anyone can create new custom diet types, never as a default/system type
      allow create: if request.auth != null &&
                       request.resource.data.createdBy == request.auth.uid &&
                       request.resource.data.get('isDefault', false) == false &&
                       request.resource.data.name is string &&
                       request.resource.data.name.size() >= 1 &&
                       request.resource.data.name.size() <= 50;

      // Only creator can update their custom diet types, and cannot turn them into
      // system or default types. System diet types cannot be updated by users.
      allow update: if request.auth != null &&
                       resource.data.createdBy != 'system' &&
                       resource.data.createdBy == request.auth.uid &&
                       request.resource.data.createdBy == resource.data.createdBy &&
                       request.resource.data.get('isDefault', false) == resource.data.get('isDefault', false) &&
                       (!('name' in request.resource.data) ||
                        (request.resource.data.name is string &&
                         request.resource.data.name.size() >= 1 &&
                         request.resource.data.name.size() <= 50));

      // Only creator can delete their custom diet types
      // System diet types cannot be deleted
      allow delete: if request.auth != null &&
                       resource.data.createdBy != 'system' &&
                       resource.data.createdBy == request.auth.uid;
    }

    // User Diet Type Preferences - subcollection under users
    match /users/{userId}/dietTypePreferences/{preferenceId} {
      // Users can read and write only their own preferences
      allow read, create, update, delete: if request.auth != null &&
                                             request.auth.uid == userId;
    }

    // Referrals - for My Circle feature
    match /referrals/{referralId} {
      // The new user records who referred them (they cannot create records for others)
      allow create: if request.auth != null &&
                       request.resource.data.referredUserId == request.auth.uid &&
                       request.resource.data.referrerId != request.auth.uid &&
                       request.resource.data.referrerId is string &&
                       request.resource.data.referredUserId is string &&
                       request.resource.data.status in ['pending', 'active', 'rewarded'] &&
                       request.resource.data.level in [1, 2];

      // Allow reading specific referral if user is involved
      allow read: if request.auth != null &&
                     (resource.data.referrerId == request.auth.uid ||
                      resource.data.referredUserId == request.auth.uid);

      // List queries only for your own referrals (the query must filter on your uid)
      allow list: if request.auth != null &&
                     (resource.data.referrerId == request.auth.uid ||
                      resource.data.referredUserId == request.auth.uid);
    }

    // Product Cache - retired. Anyone could write it, so entries could be faked for every
    // user; the app no longer uses it (products come from productCatalog, written by the
    // server). Closed to clients.
    match /productCache/{cacheKey} {
      allow read, write: if false;
    }

    // Product Catalog - server-filled OpenFoodFacts catalog (doc id = ingredient catalog key)
    // Only the Admin SDK (lookupCatalogProducts function, seed script) writes.
    match /productCatalog/{key} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // User Product Cache - user-specific product cache
    match /userProductCache/{cacheId} {
      // Users can read/write only their own cache entries (ID format: userId_barcode).
      // Updates and deletes check the stored owner, so nobody can take over another user's entry.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;
    }

    // User Product Preferences - user-specific preferences
    match /userProductPreferences/{userId} {
      // Users can read and write only their own preferences
      allow read, create, update: if request.auth != null && request.auth.uid == userId;

      // Allow delete for cleanup
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // User Item History - track frequently added items
    match /userItemHistory/{historyId} {
      // Users can read/write only their own history (ID format: userId_itemName).
      // Updates check the stored owner, so nobody can take over another user's entry.
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == request.auth.uid;
    }

    // Shopping List Templates - reusable shopping lists
    match /shoppingListTemplates/{templateId} {
      // Allow create only if userId matches authenticated user
      allow create: if request.auth != null &&
                       request.resource.data.userId == request.auth.uid;

      // Allow read and delete only if user owns the template
      allow read, delete: if request.auth != null &&
                             resource.data.userId == request.auth.uid;

      // Allow update only by the owner, and the owner cannot be changed
      allow update: if request.auth != null &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.userId == resource.data.userId;
    }

    // Admins: a document at admins/{uid}, created by hand in the Firebase console.
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      // Users may check whether they are an admin; nobody can grant it from the app.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Shared ingredient dictionary: same-product aliases applied for every user.
    // Read by everyone signed in; changed only by admins; never deleted (switched off).
    match /ingredientDictionary/{entryId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin() &&
                               request.resource.data.alias is string &&
                               request.resource.data.alias.size() > 0 &&
                               request.resource.data.alias.size() <= 80 &&
                               request.resource.data.enabled is bool &&
                               (!('canonical' in request.resource.data) ||
                                (request.resource.data.canonical is string &&
                                 request.resource.data.canonical.size() <= 80));
      allow delete: if false;
    }

    // Alias suggestions from users, reviewed by admins.
    match /ingredientAliasSuggestions/{suggestionId} {
      allow create: if request.auth != null &&
                       request.resource.data.suggestedBy == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.alias is string &&
                       request.resource.data.alias.size() > 0 &&
                       request.resource.data.alias.size() <= 80 &&
                       request.resource.data.canonical is string &&
                       request.resource.data.canonical.size() > 0 &&
                       request.resource.data.canonical.size() <= 80;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
